# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/

# 前端依赖（web/package-lock.json 入库，node_modules 不入库）
node_modules/
web/.vite/
# vite 在读取配置文件时落下的临时产物（每次构建都会生成、正常退出时自行删除，
# 异常退出会残留；文件名含时间戳，属于噪声，不入库）
web/vite.config.ts.timestamp-*.mjs

# 仿真产物（体积大，禁止入库）
images/
scratch/
# Windows 路径误转义产物（如 iris-home/scratch;C）
scratch*/
firmwares/
*.tar.gz
*.qcow2
*.raw
*.img
*.img.gz
qemu.*.serial.log
qemu.initial.serial.log
qemu.final.serial.log

# 语料下载物（清单 TOML 入库，固件本体不入库）
iris-home/corpus/*
!iris-home/corpus/*.toml

# 运行时数据
# LLM 生成的规则草案目录（人工确认安装后才落到 plugins/，草稿本身是本机产物）
iris-home/ai-drafts/
*.db
*.sqlite3
logs/
runtime/

# IDE / OS
.idea/
.vscode/
Thumbs.db
.DS_Store

# 智能体工具缓存（索引快照、会话数据，与源码无关）
.codeartsdoer/
.merkle-snapshot.json

# 密钥与配置
.env
*.local.yaml

# 智能体技能安装目录（由 `npx skills add ...` 写入，含第三方脚本，同 .codeartsdoer/ 理由不入库）
.agents/
.claude/
.workbuddy/